{
  "name": "@pyanllc/mcp-db-fetcher",
  "version": "5.7.0",
  "description": "MCP server for MS SQL schema and data fetching",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "node ../../../build.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "tsx src/test-client.ts",
    "test:unit": "tsx --test src/connection-manager.test.ts src/project-context.test.ts",
    "test:plugin": "tsx --test src/plugin.test.ts"
  },
  "keywords": [
    "mcp",
    "mssql",
    "sql-server",
    "schema",
    "claude",
    "db-fetcher"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "mssql": "^11.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5"
  }
}
